# This file is not loaded automatically. It may be shared by Docker Compose and
# load_settings(env_file=Path(".env")); unknown keys are rejected. Do not put
# real credentials in this file.
CAREER_OS_ENVIRONMENT=development
CAREER_OS_LOG_LEVEL=INFO
CAREER_OS_REQUEST_TIMEOUT_SECONDS=30
CAREER_OS_ENABLE_WORKABLE_PUBLIC=false
CAREER_OS_MAX_FETCH_DROP_RATIO=0.5
CAREER_OS_CIRCUIT_FAILURE_THRESHOLD=3
CAREER_OS_CIRCUIT_COOLDOWN_SECONDS=900
CAREER_OS_FRESHNESS_TARGET_SECONDS=86400

# Local Docker Compose PostgreSQL only. These development defaults are not for
# shared or production environments. Set your own local password before starting Compose.
POSTGRES_DB=career_os
POSTGRES_USER=career_os
POSTGRES_PASSWORD=
CAREER_OS_POSTGRES_PORT=5432
CAREER_OS_DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${CAREER_OS_POSTGRES_PORT}/${POSTGRES_DB}
